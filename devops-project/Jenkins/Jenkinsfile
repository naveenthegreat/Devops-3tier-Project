pipeline {
    agent any
    stages {
	stage('Clone Repository') {
	    steps {
		git branch: 'main', 
		url: 'https://github.com/naveenthegreat/Devops-3tier-Project.git'		}
	}

	stage('Build Backend') {
	    steps {
		sh 'docker build -t backend.app ./devops-project/backend'
	    }
	}

	stage('Build Frontend') {
	    steps {
		sh 'docker build -t frontend-app ./devops-project/frontend'
	    }
	}
    }
}
